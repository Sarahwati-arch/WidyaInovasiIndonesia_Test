# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_portal

# JWT (use a long random value in production, at least 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# Password hashing
BCRYPT_ROUNDS=10

# CORS: comma separated list of allowed origins, or * for all
CORS_ORIGIN=*
